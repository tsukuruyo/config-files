      "Bash(ssh *)",
      "Bash(sudo *)",
      "Edit(.claude/settings*.json)",
      "Edit(//etc/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/statusline.sh)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.zshrc)",
