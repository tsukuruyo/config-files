{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NEW_INIT": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "language": "Japanese",
  "cleanupPeriodDays": 876000,
  "disableSkillShellExecution": true,
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "unity@unity-agent-plugin": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "unity-agent-plugin": {
      "source": {
        "source": "github",
        "repo": "Unity-Technologies/unity-agent-plugin"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowLocalBinding": false
    },
    "excludedCommands": [
      "docker build *",
      "docker compose *",
      "docker images *",
      "docker logs *",
      "docker ps *",
      "dotnet format *",
      "gh api *",
      "gh issue close *",
      "gh issue comment *",
      "gh issue create *",
      "gh issue edit *",
      "gh issue list *",
      "gh issue view *",
      "gh pr checks *",
      "gh pr close *",
      "gh pr comment *",
      "gh pr create *",
      "gh pr diff *",
      "gh pr edit *",
      "gh pr list *",
      "gh pr merge *",
      "gh pr review *",
      "gh pr status *",
      "gh pr view *",
      "gh repo view *",
      "gh run list *",
      "gh run view *",
      "gh run watch *",
      "gh status *",
      "git branch *",
      "git checkout *",
      "git clean *",
      "git clone *",
      "git fetch *",
      "git ls-remote *",
      "git merge *",
      "git pull *",
      "git push *",
      "git rebase *",
      "git stash clear *",
      "git stash drop *",
      "git submodule update *",
      "git switch *",
      "orca agent installed *",
      "orca agent launch *",
      "orca agent list *",
      "orca agent read *",
      "orca agent show *",
      "orca automations *",
      "orca bot *",
      "orca linear *",
      "orca orchestration *",
      "orca ports *",
      "orca repo add *",
      "orca repo list *",
      "orca repo search-refs *",
      "orca repo set *",
      "orca repo set-base-ref *",
      "orca repo show *",
      "orca skills get *",
      "orca status *",
      "orca terminal list *",
      "orca terminal read *",
      "orca terminal create *",
      "orca terminal send *",
      "orca terminal show *",
      "orca terminal split *",
      "orca terminal wait *",
      "orca webhooks list*",
      "orca worktree add *",
      "orca worktree create *",
      "orca worktree current *",
      "orca worktree list *",
      "orca worktree ps *",
      "orca worktree set *",
      "orca worktree show *",
      "unity *"
    ],
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.gem/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        },
        {
          "path": "~/.pypirc",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/Library/Keychains",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "tui": "fullscreen",
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
