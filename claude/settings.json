      "Bash(orca linear search *)",
      "Bash(orca open *)",
      "Bash(orca orchestration *)",
      "Bash(orca ports *)",
      "Bash(orca repo list *)",
      "Bash(orca repo search-refs *)",
      "Bash(orca repo show *)",
      "Bash(orca slack find *)",
      "Bash(orca slack read *)",
      "Bash(orca status *)",
      "Bash(orca terminal list *)",
      "Bash(orca terminal read *)",
      "Bash(orca terminal show *)",
      "Bash(orca terminal wait *)",
      "Bash(orca webhooks list *)",
      "Bash(orca worktree create *)",
      "Bash(orca worktree current *)",
      "Bash(orca worktree list *)",
      "Bash(orca worktree ps *)",
      "Bash(orca worktree show *)",
      "Bash(unity command console get *)",
      "Bash(unity command console status *)",
      "Bash(unity command test run *)",
      "Bash(unity command test status *)",
      "Bash(unity recompile *)",
      "Bash(unity status *)",
      "Edit(~/.cos/reports/**)",
      "Read(~/.cos/reports/**)"
